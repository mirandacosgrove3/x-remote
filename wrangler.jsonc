{
  // Change "name" if you want a different URL: https://<name>.<your-subdomain>.workers.dev
  "name": "couch-remote",
  "main": "src/worker.js",
  "workers_dev": true,
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "TOKENS",
      // Paste the id printed by: npx wrangler kv namespace create TOKENS
      "id": "27a99d76e7954bfdbe4f23781b5682b4"
    }
  ],
  "vars": {
    "MOCK_XBOX": "0"
  }
}
